<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>EnhancedEffectRemover.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemDefinitionGroup>
        <Reference>
            <Private>false</Private>
        </Reference>
    </ItemDefinitionGroup>

    <ItemGroup>
        <Compile Include="..\EnhancedEffectRemover\Features\ConditionalTags.cs" />
        <Compile Include="..\EnhancedEffectRemover\Config\Settings.cs" />
        <Compile Include="..\EnhancedEffectRemover\Log.cs" />
        <Compile Include="..\EnhancedEffectRemover\Info.cs" />
        <Reference Include="MelonLoader">
            <HintPath>$(GamePath)/MelonLoader/net35/MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(GamePath)/$(GameData)/Managed/Newtonsoft.Json.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
