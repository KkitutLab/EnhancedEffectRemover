<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>EnhancedEffectRemover</RootNamespace>
        <AssemblyName>EnhancedEffectRemover</AssemblyName>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyVersion>2.0.4.0</AssemblyVersion>
        <FileVersion>2.0.4.0</FileVersion>
        <Version>2.0.4</Version>
        <NeutralLanguage>en-US</NeutralLanguage>
    </PropertyGroup>

    <PropertyGroup>
        <O5KitProject Condition="'$(O5KitProject)' == ''">../../O5Kit/src/O5Kit/O5Kit.csproj</O5KitProject>
        <O5KitConfiguration>$(Configuration)</O5KitConfiguration>
        <NCalcVersion>7.0.2</NCalcVersion>
        <ParlotVersion>1.5.8</ParlotVersion>
        <ImmutableVersion>10.0.10</ImmutableVersion>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(O5KitProject)')">
        <ProjectReference Include="$(O5KitProject)">
            <SetConfiguration>Configuration=$(O5KitConfiguration)</SetConfiguration>
            <SetTargetFramework>TargetFramework=netstandard2.1</SetTargetFramework>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup Condition="!Exists('$(O5KitProject)')">
        <Reference Include="O5Kit">
            <HintPath>$(GamePath)/UserLibs/O5Kit.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ncalc" Version="7.0.2" />
    </ItemGroup>

    <ItemDefinitionGroup>
        <Reference>
            <Private>false</Private>
        </Reference>
    </ItemDefinitionGroup>

    <ItemGroup>
        <Reference Include="MelonLoader">
            <HintPath>$(GamePath)/MelonLoader/net35/MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(GamePath)/MelonLoader/net35/0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GamePath)/$(GameData)/Managed/Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="RDTools">
            <HintPath>$(GamePath)/$(GameData)/Managed/RDTools.dll</HintPath>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(GamePath)/$(GameData)/Managed/Newtonsoft.Json.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.IMGUIModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.InputLegacyModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.UI.dll</HintPath>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(GamePath)/$(GameData)/Managed/Unity.TextMeshPro.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="Build">
        <MakeDir Directories="$(GamePath)/Mods" Condition="'$(TargetPath)' != ''" />
        <Copy Condition="'$(TargetPath)' != ''" SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)/Mods" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(TargetDir)O5Kit.dll" DestinationFolder="$(GamePath)/UserLibs" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)O5Kit.dll')" />
        <ItemGroup>
            <O5KitDeps Include="$(NuGetPackageRoot)ncalc/$(NCalcVersion)/lib/netstandard2.0/NCalc.dll" />
            <O5KitDeps Include="$(NuGetPackageRoot)ncalc.core/$(NCalcVersion)/lib/netstandard2.0/NCalc.Core.dll" />
            <O5KitDeps Include="$(NuGetPackageRoot)ncalc.domain/$(NCalcVersion)/lib/netstandard2.0/NCalc.Domain.dll" />
            <O5KitDeps Include="$(NuGetPackageRoot)ncalc.parser/$(NCalcVersion)/lib/netstandard2.0/NCalc.Parser.dll" />
            <O5KitDeps Include="$(NuGetPackageRoot)parlot/$(ParlotVersion)/lib/netstandard2.0/Parlot.dll" />
            <O5KitDeps Include="$(NuGetPackageRoot)system.collections.immutable/$(ImmutableVersion)/lib/netstandard2.0/System.Collections.Immutable.dll" />
        </ItemGroup>
        <MakeDir Directories="$(GamePath)/UserLibs" Condition="'@(O5KitDeps)' != ''" />
        <Copy SourceFiles="@(O5KitDeps)" DestinationFolder="$(GamePath)/UserLibs" SkipUnchangedFiles="true" />
    </Target>

</Project>
